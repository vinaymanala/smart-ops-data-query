# Local .terraform directories (contains provider plugins and metadata)
**/.terraform/*

# .tfstate files (contains sensitive infrastructure data and state)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files (likely to contain sensitive passwords, tokens, or keys)
*.tfvars
*.tfvars.json

# Ignore override files as they are used for local alterations
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include tfplan files (binary plan outputs that shouldn't be versioned)
*tfplan*

# Ignore CLI configuration files
.terraformrc
terraform.rc
